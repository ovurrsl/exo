 namespace mlx::core {
 
 std::filesystem::path current_binary_dir() {
   static std::filesystem::path binary_dir = []() {
+#ifdef _WIN32
+    HMODULE module = nullptr;
+    if (!::GetModuleHandleExW(
+            GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            reinterpret_cast<LPCWSTR>(&current_binary_dir), &module)) {
+      throw std::runtime_error("Unable to get current binary dir.");
+    }
+    std::wstring filename(1024, L'\0');
+    while (true) {
+      DWORD length = ::GetModuleFileNameW(module, filename.data(), DWORD(filename.size()));
+      if (length == 0) {
+        throw std::runtime_error("Unable to get current binary dir.");
+      }
+      if (length < filename.size()) {
+        filename.resize(length);
+        return std::filesystem::path(filename).parent_path();
+      }
+      if (filename.size() >= 32768) {
+        throw std::runtime_error("Current binary path is too long.");
+      }
+      filename.resize(std::min<size_t>(filename.size() * 2, 32768));
+    }
+#else
     Dl_info info;
     if (!dladdr(reinterpret_cast<void*>(&current_binary_dir), &info)) {
       throw std::runtime_error("Unable to get current binary dir.");
     }
     return std::filesystem::path(info.dli_fname).parent_path();
+#endif
   }();
   return binary_dir;
 }
