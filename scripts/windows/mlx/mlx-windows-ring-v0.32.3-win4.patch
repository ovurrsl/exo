diff --git a/mlx/windows_utils.h b/mlx/windows_utils.h
new file mode 100644
index 0000000000000000000000000000000000000000..5dbd3020e5ebf2b9523b821dbc9c6b1e3949885f
--- /dev/null
+++ b/mlx/windows_utils.h
@@ -0,0 +1,123 @@
+// Windows paths exposed by Python are UTF-8; use the wide Win32/CRT APIs.
+#pragma once
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <io.h>
+#include <sys/stat.h>
+
+#include <climits>
+#include <filesystem>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+
+namespace mlx::core::windows {
+
+inline std::wstring utf8_to_wide(std::string_view text) {
+  if (text.empty()) {
+    return {};
+  }
+  if (text.size() > INT_MAX) {
+    throw std::invalid_argument("Windows UTF-8 path is too long.");
+  }
+  int size = ::MultiByteToWideChar(
+      CP_UTF8, MB_ERR_INVALID_CHARS, text.data(), int(text.size()), nullptr, 0);
+  if (size == 0) {
+    throw std::invalid_argument("Invalid UTF-8 Windows path.");
+  }
+  std::wstring result(size, L'\0');
+  if (::MultiByteToWideChar(
+          CP_UTF8, MB_ERR_INVALID_CHARS, text.data(), int(text.size()),
+          result.data(), size) != size) {
+    throw std::invalid_argument("Invalid UTF-8 Windows path.");
+  }
+  return result;
+}
+
+inline std::string wide_to_utf8(std::wstring_view text) {
+  if (text.empty()) {
+    return {};
+  }
+  if (text.size() > INT_MAX) {
+    throw std::invalid_argument("Windows wide path is too long.");
+  }
+  int size = ::WideCharToMultiByte(
+      CP_UTF8, WC_ERR_INVALID_CHARS, text.data(), int(text.size()), nullptr, 0,
+      nullptr, nullptr);
+  if (size == 0) {
+    throw std::invalid_argument("Invalid Windows wide path.");
+  }
+  std::string result(size, '\0');
+  if (::WideCharToMultiByte(
+          CP_UTF8, WC_ERR_INVALID_CHARS, text.data(), int(text.size()),
+          result.data(), size, nullptr, nullptr) != size) {
+    throw std::invalid_argument("Invalid Windows wide path.");
+  }
+  return result;
+}
+
+inline std::filesystem::path utf8_path(std::string_view path) {
+  return std::filesystem::path(utf8_to_wide(path));
+}
+
+inline std::string path_utf8(const std::filesystem::path& path) {
+  return wide_to_utf8(path.native());
+}
+
+inline std::optional<std::string> path_ansi(const std::filesystem::path& path) {
+  const auto& text = path.native();
+  if (text.empty()) {
+    return std::string();
+  }
+  if (text.size() > INT_MAX) {
+    throw std::invalid_argument("Windows include path is too long.");
+  }
+  UINT codepage = ::GetACP();
+  BOOL substituted = FALSE;
+  BOOL* used_default = codepage == CP_UTF8 ? nullptr : &substituted;
+  DWORD flags = codepage == CP_UTF8 ? 0 : WC_NO_BEST_FIT_CHARS;
+  int size = ::WideCharToMultiByte(
+      codepage, flags, text.data(), int(text.size()), nullptr, 0, nullptr,
+      used_default);
+  if (size == 0 || substituted) {
+    return std::nullopt;
+  }
+  std::string result(size, '\0');
+  if (::WideCharToMultiByte(
+          codepage, flags, text.data(), int(text.size()), result.data(), size,
+          nullptr, used_default) != size || substituted) {
+    return std::nullopt;
+  }
+  return result;
+}
+
+inline std::optional<std::string> getenv_utf8(const wchar_t* name) {
+  DWORD size = ::GetEnvironmentVariableW(name, nullptr, 0);
+  if (size == 0) {
+    return std::nullopt;
+  }
+  std::wstring value(size, L'\0');
+  DWORD length = ::GetEnvironmentVariableW(name, value.data(), size);
+  if (length == 0 || length >= size) {
+    return std::nullopt;
+  }
+  value.resize(length);
+  return wide_to_utf8(value);
+}
+
+inline int open_utf8(std::string_view path, int flags) {
+  auto wide_path = utf8_to_wide(path);
+  // POSIX 0644 has invalid group/other bits for the Microsoft CRT pmode.
+  return ::_wopen(wide_path.c_str(), flags, _S_IREAD | _S_IWRITE);
+}
+
+} // namespace mlx::core::windows
+#endif
