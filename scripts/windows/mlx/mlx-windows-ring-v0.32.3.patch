+            "cuda_nvrtc",
+            "cufft",
+            "cusolver",
+            "cusparse",
+            "nvjitlink"}) {
+        dirs.push_back(relative_to_current_binary("../nvidia") / name / "bin");
+      }
+    }
+    std::wstring path;
+    std::error_code error;
+    for (const auto& dir : dirs) {
+      if (fs::exists(dir, error)) {
+        path += dir.wstring() + L";";
+      }
+    }
+    DWORD size = ::GetEnvironmentVariableW(L"PATH", nullptr, 0);
+    std::wstring old_path(size, L'\0');
+    DWORD length = ::GetEnvironmentVariableW(L"PATH", old_path.data(), size);
+    old_path.resize(length < size ? length : 0);
+    ::SetEnvironmentVariableW(L"PATH", (path + old_path).c_str());
+  });
